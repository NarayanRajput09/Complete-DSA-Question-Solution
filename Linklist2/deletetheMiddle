class Solution {
    public ListNode deleteMiddle(ListNode head) {
       if(head.next == null) {
        return null;
       }
       ListNode first = head;
       ListNode second = head;
       while(first.next.next != null && first.next.next.next !=null){
        first = first.next.next;
        second = second.next;
       }
       second.next = second.next.next;
       return head;
    }
}