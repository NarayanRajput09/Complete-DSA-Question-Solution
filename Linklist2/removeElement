class Solution {
    public ListNode removeElements(ListNode  head, int val) {
        if(head == null){
            return null;
        }
        ListNode ptr1 = head;
        ListNode ptr2 = head.next;
               while(ptr2 != null){ 
        if(ptr2.val == val ){ 
            ptr1.next = ptr2.next ; 
            ptr2 = ptr1.next; 
        }else{ 
            ptr1 = ptr1.next; 
            ptr2 = ptr1.next; 
             }
               }
        if(head.val == val){ 
        head = head.next; 
                      }
          return head; 

    }
}